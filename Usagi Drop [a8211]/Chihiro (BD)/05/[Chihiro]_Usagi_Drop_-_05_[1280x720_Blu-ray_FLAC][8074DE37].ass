Dialogue: 0,0:20:56.36,0:21:00.57,ED Romaji,,0000,0000,0000,,{\be1}utae Life Life Life
Dialogue: 0,0:21:01.21,0:21:06.88,ED Romaji,,0000,0000,0000,,{\be1}koe wa dokomademo
Dialogue: 0,0:21:06.88,0:21:11.04,ED Romaji,,0000,0000,0000,,{\be1}mou High High High
Dialogue: 0,0:21:11.70,0:21:16.66,ED Romaji,,0000,0000,0000,,{\be1}maiagaru kaze ni nori
