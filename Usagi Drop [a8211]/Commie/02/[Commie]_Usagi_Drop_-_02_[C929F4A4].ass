Dialogue: 0,0:02:04.06,0:02:07.86,OP,,0000,0000,0000,,{\fad(200,200)\blur1}{\1c&H827B25&}A{\1c&H778D3A&}n{\1c&H6F9B4B&}d{\1c&H66AA5D&} {\1c&H60B56A&}t{\1c&H59C179&}h{\1c&H50D18C&}o{\1c&H48E09E&}s{\1c&H4BE4AB&}e{\1c&H61D8B2&} {\1c&H73CEB9&}d{\1c&H8BC1C0&}a{\1c&HA3B4C8&}y{\1c&HB9A8D0&}s{\1c&HCC9DD6&} {\1c&HE490DE&}w{\1c&HED91D7&}i{\1c&HEE95CF&}l{\1c&HEE98C8&}l{\1c&HEF9EBE&} {\1c&HF0A6AF&}b{\1c&HF1AF9E&}e{\1c&HF2B690&} {\1c&HF3BE80&}h{\1c&HF4C76F&}a{\1c&HE5BE6E&}p{\1c&HCAA57A&}p{\1c&HAF8C86&}y{\1c&H9E7D8D&},{\1c&H8C6C95&} {\1c&H77599E&}t{\1c&H5C41AA&}o{\1c&H4128B6&}o{\1c&H3019BE&}!
