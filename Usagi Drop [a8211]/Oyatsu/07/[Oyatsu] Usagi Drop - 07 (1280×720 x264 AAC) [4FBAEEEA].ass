Dialogue: 0,0:01:43.82,0:01:46.44,OP English,,0000,0000,0000,,Love's sweet drops, sweet drops.
Dialogue: 0,0:01:46.44,0:01:49.95,OP Romaji,,0000,0000,0000,,{\k25}{\k65}zu{\k45}tto {\k20}yu{\k24}me {\k22}mi{\k28}te{\k13} {\k19}i{\k25}ta{\k22}i{\k43}ne.
Dialogue: 0,0:01:46.44,0:01:49.95,OP Kanji,,0000,0000,0000,,{\k25}{\k65}ず{\k45}っと{\k44}夢{\k22}み{\k28}て{\k13}{\k19}い{\k25}た{\k22}い{\k43}ネ。
Dialogue: 0,0:01:46.44,0:01:49.95,OP English,,0000,0000,0000,,How I wish my dreams could continue on and on.
Dialogue: 0,0:01:49.95,0:01:53.24,OP Romaji,,0000,0000,0000,,{\k20}{\k47}mo{\k15}{\k43}tto {\k14}ya{\k23}sa{\k30}shi{\k20}ku{\k26} {\k18}shi{\k22}ta{\k20}i{\k31}ne.
